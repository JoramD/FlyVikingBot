# FlyVikingBot configuration. Copy to .env and fill in.
# Settings marked "required" must be set; an empty optional channel or ID switches that feature off.

# =====================================================================================================
# Discord
# =====================================================================================================
# Bot token (required)
DISCORD_TOKEN=
# Server ID: commands appear instantly and the bot knows which server to link members in
GUILD_ID=

# --- Channels ---
# Blog announcements (@everyone) and new/updated downloads
CHANNEL_ANNOUNCEMENTS=631949277559783457
# New gallery images
CHANNEL_SCREENSHOTS=631950027476172810
# Completed FSAirlines flights
CHANNEL_FLIGHT_LOGS=
# Staff channel (#system-messages): link reviews, rank problems, link notices
CHANNEL_SYSTEM_MESSAGES=
# Bot development channel: test previews of every post type (python -m flyvikingbot.tools.preview_posts)
CHANNEL_BOT_DEVELOPMENT=

# --- Roles ---
# Pinged on #system-messages posts that need staff action (@Board of Directors; empty = no ping)
SYSTEM_MESSAGES_ROLE_ID=631901856997834778
# Comma-separated Discord roles (and website groups) the bot may assign for FSA ranks, matched to
# rank names. Any other rank (e.g. Board of Directors) is never assigned automatically.
# Empty = rank roles and website rank groups are switched off.
FSA_RANK_ROLES=Trainee Pilot,First Officer,Senior First Officer,Cargo First Officer,Captain,Cargo Captain

# =====================================================================================================
# Website (Invision Community)
# =====================================================================================================
# REST API key (required); see the README for the endpoints it needs
WEBSITE_API_KEY=
# Secret part of the webhook URLs (required). Long random string, e.g.
# `python -c "import secrets;print(secrets.token_urlsafe(32))"`
WEBHOOK_SECRET=
# Only post blog entries from this blog as announcements (empty = every blog)
ANNOUNCEMENT_BLOG_ID=
# IDs of the two custom profile fields used for linking (ACP → Members → Profiles → Profile Fields)
IPS_FIELD_FSA_PILOT_ID=
IPS_FIELD_DISCORD_NAME=
# ID of a profile field members can NOT edit, which the bot fills with the pilot's FSA rank so it shows on
# their profile (empty = off). Updated with the rank sync, so FSA_RANK_ROLES must be set.
IPS_FIELD_FSA_RANK=
# Mirror FSA ranks to website secondary member groups named like FSA_RANK_ROLES. Needs those groups
# and an API key allowed to use GET /core/groups and GET + POST /core/members/{id}.
WEBSITE_RANK_SYNC=true
# Pilots on one of the ranks get this primary group (their old primary is kept as a secondary group)...
WEBSITE_MEMBER_GROUP=Members
# ...unless their primary group is one of these (staff keep their access)
WEBSITE_PROTECTED_GROUPS=Administrators,Moderators

# =====================================================================================================
# FSAirlines
# =====================================================================================================
# API key (required) and VA ID (required; FlyViking: 42982)
FSA_API_KEY=
FSA_VA_ID=42982
# How often to check for completed flights (seconds, min 60)
FSA_POLL_SECONDS=120
# How often to sync rank roles (minutes, min 5); staff can force it with /sync_rank
FSA_RANK_SYNC_MINUTES=60

# =====================================================================================================
# SayIntentions.AI (optional; /weather is off unless both the app and account key are set)
# =====================================================================================================
# Identifies the bot as an application: pilot portal → Developer Key page (a personal key is enough)
SAYINTENTIONS_APP_KEY=
# Identifies the SayIntentions account the bot uses: pilot portal → Account page → "API Key (ACARS ID)"
SAYINTENTIONS_ACCOUNT_KEY=
# FlyViking's VA-Link key from SayIntentions support. Not used yet; reserved for crew personas
SAYINTENTIONS_VA_KEY=

# =====================================================================================================
# Monitoring & debugging
# =====================================================================================================
# Uptime Kuma push URL; heartbeat is disabled when empty
UPTIME_KUMA_URL=
# Save incoming webhook payloads to data/webhook_samples/ (personal data redacted; for debugging only)
WEBHOOK_CAPTURE=false
WEBHOOK_CAPTURE_KEEP=50

# =====================================================================================================
# Advanced (defaults are fine)
# =====================================================================================================
# Port of the webhook server inside the container
WEBHOOK_PORT=8080
# Website REST API endpoint
# WEBSITE_BASE_URL=https://flyviking.net/api/index.php
# Address the webhook server listens on inside the container
# WEBHOOK_BIND=0.0.0.0
# Folder for logs, the database (flyviking.db) and captures; the Docker image uses /app/data
# DATA_DIR=data

# --- docker-compose only ---
# Docker network created by this compose file; the website's cron container joins it as external
DOCKER_NETWORK=flyviking-bot

# --- Required secrets ---
DISCORD_TOKEN=
FSA_API_KEY=
WEBSITE_API_KEY=
# Long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`
WEBHOOK_SECRET=

# --- Optional ---
# Uptime Kuma push URL; heartbeat is disabled when empty
UPTIME_KUMA_URL=
# Set to the server ID for instant slash-command sync (otherwise global sync, can take a while)
GUILD_ID=
FSA_VA_ID=42982
CHANNEL_ANNOUNCEMENTS=631949277559783457
CHANNEL_SCREENSHOTS=631950027476172810
# Only post blog entries from this blog as announcements (empty = every blog)
ANNOUNCEMENT_BLOG_ID=
# Save incoming webhook payloads to data/webhook_samples/ (personal data redacted; for debugging only)
WEBHOOK_CAPTURE=false
WEBHOOK_CAPTURE_KEEP=50
WEBHOOK_PORT=8080

# --- FSAirlines integration (each feature is off while its setting is empty) ---
# Channel for completed-flight logs
CHANNEL_FLIGHT_LOGS=
# Staff channel (#system-messages) for link reviews, rank-role problems and link notices
CHANNEL_SYSTEM_MESSAGES=
# Role pinged on #system-messages posts that need staff action (default: @Board of Directors; empty = no ping)
SYSTEM_MESSAGES_ROLE_ID=631901856997834778
# IDs of the two IPS custom profile fields (ACP → Members → Profiles → Profile Fields)
IPS_FIELD_FSA_PILOT_ID=
IPS_FIELD_DISCORD_NAME=
# How often to check FSAirlines for completed flights (seconds, min 60)
FSA_POLL_SECONDS=120
# How often to sync rank roles (minutes, min 5); staff can force it with /sync_rank
FSA_RANK_SYNC_MINUTES=60
# Comma-separated Discord roles (and website groups) the bot may assign for FSA ranks, matched to
# rank names. Any other rank (e.g. Board of Directors) is never assigned automatically.
FSA_RANK_ROLES=Trainee Pilot,First Officer,Senior First Officer,Cargo First Officer,Captain,Cargo Captain
# Also mirror ranks to website secondary member groups with the same names. Needs website groups with
# those names and an API key allowed to use GET /core/groups and GET + POST /core/members/{id}.
WEBSITE_RANK_SYNC=false
# Pilots on one of the ranks above get this primary group (their old primary is kept as a secondary group)...
WEBSITE_MEMBER_GROUP=Members
# ...unless their primary group is one of these (staff keep their access)
WEBSITE_PROTECTED_GROUPS=Administrators,Moderators

# --- docker-compose only ---
# External Docker network shared with the website's PHP and cron containers (docker network create flyviking)
DOCKER_NETWORK=flyviking
